APP_NAME=kyc-onboarding-agent
APP_VERSION=0.1.0
ENVIRONMENT=local
DATABASE_PATH=./kyc_demo.db
LLM_PROVIDER=mock
OPENAI_API_KEY=
OPENAI_MODEL=gpt-4o-mini
OTEL_ENABLED=false
OTEL_EXPORTER_OTLP_ENDPOINT=http://otel-collector:4317
DRIFT_WINDOW_SIZE=20
DRIFT_MIN_SAMPLES=10
DRIFT_WARNING_ACCURACY=0.97
DRIFT_CRITICAL_ACCURACY=0.95
GRAFANA_ADMIN_PASSWORD=change-me

# RAG / policy knowledge base
OPENAI_EMBEDDING_MODEL=text-embedding-3-small
RAG_DOCUMENTS_DIR=./documents
CHROMA_PERSIST_DIR=./chroma_store
CHROMA_COLLECTION=kyc_policy_knowledge
RAG_CHUNK_SIZE=1000
RAG_CHUNK_OVERLAP=150

# Retrieval scope gate (Chroma cosine distance; tune with labelled test questions)
RAG_SCOPE_DISTANCE_THRESHOLD=0.75
